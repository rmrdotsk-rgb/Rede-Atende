# Padrão: PostgreSQL nativo. Copie para .env e preencha sua senha local.
DB_MODE=postgres
DATABASE_URL=postgresql://rede_atende:SUA_SENHA_LOCAL@localhost:5432/rede_atende
PORT=3001
SESSION_HOURS=8
# true quando servido exclusivamente por HTTPS. HTTP local: false.
COOKIE_SECURE=false
SERVE_FRONTEND=false
DATA_DIR=.local/data
UPLOAD_DIR=.local/uploads
# Opcionais: senhas de 12–128 caracteres. Vazias geram valores aleatórios no setup.
# Valem apenas para contas ainda não cadastradas. Repetir setup preserva os hashes existentes.
# Recuperação explícita, com servidor parado e backup: veja docs/ACESSOS_LOCAIS.md.
SEED_GESTOR_PASSWORD=
SEED_OPERADOR_PASSWORD=
SEED_AUDITOR_PASSWORD=
SEED_CIDADAO_PASSWORD=
