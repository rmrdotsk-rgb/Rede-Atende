{
  "name": "rede-atende",
  "private": true,
  "version": "3.12.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run lint && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "lint": "npm run typecheck && eslint .",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "dev:web": "vite --port 3000 --host 0.0.0.0 --strictPort",
    "dev:api": "node --watch --import tsx server/index.ts",
    "start": "node --import tsx scripts/start.mjs",
    "db:migrate": "node --import tsx server/db/migrate.ts",
    "db:seed": "node --import tsx server/db/seed.ts",
    "setup": "node scripts/setup.mjs",
    "demo:reset-password": "node --import tsx scripts/reset-demo-password.mts",
    "test:api": "node --import tsx --test --test-concurrency=1 server/tests/*.test.ts",
    "db:backup": "node --import tsx server/db/backup.ts",
    "db:verify-backup": "node scripts/verify-backup.mjs",
    "test:flow": "node --import tsx server/tests/shared-flow-3_5.mts",
    "test:persistence": "node --import tsx server/tests/persistence-across-processes.mts",
    "test:offline": "node --import tsx server/tests/offline-recovery.mts",
    "db:check": "node --import tsx scripts/check-integrity.mts",
    "test:performance": "node --import tsx scripts/benchmark.mts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:static": "node --test tests/static-3_9_1.test.mjs tests/hardening-current.test.mjs tests/backup-integrity.test.mjs",
    "db:restore": "node --import tsx server/db/restore.ts",
    "test:restore": "node --import tsx server/tests/logical-restore.mts",
    "test:migrations": "node --import tsx server/tests/migrations-upgrade.mts",
    "test:browser-performance": "node --import tsx scripts/browser-performance.mts . browser-performance.json",
    "pretest:api": "npm run build",
    "test:budgets": "node scripts/check-performance-budgets.mjs",
    "test:routes-performance": "node --import tsx scripts/routes-performance.mts . routes-performance.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "9.4.0",
    "@hookform/resolvers": "5.2.2",
    "fastify": "5.12.8",
    "lucide-react": "^0.546.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-is": "19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=10"
  },
  "overrides": {
    "playwright-core": "1.64.1"
  }
}
